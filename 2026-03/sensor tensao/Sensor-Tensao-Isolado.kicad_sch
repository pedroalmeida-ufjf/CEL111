		(uuid "3b812686-4b5f-48a0-a620-b9803b4a58fc")
	)
	(text "1. Entrada de ±250 V, CC ou CA, entre VIN+ e VIN-. Cada braço do divisor tem 2 MΩ (R1 e R2, R4 e R5), e R3 tem 10 kΩ:"
		(exclude_from_sim no)
		(at 25.4 212.09 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3f0773c9-7efd-4710-8b1f-72cee7426cff")
	)
	(text "Entrada e divisor"
		(exclude_from_sim no)
