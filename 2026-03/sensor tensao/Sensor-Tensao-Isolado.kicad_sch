	)
	(text "4. AMC_OUT = VREF + 0,806 (OUTP - OUTN), com VREF = 1,245 V: de 0,24 V a 2,25 V para ±250 V, 4,02 mV por volt."
		(exclude_from_sim no)
		(at 25.4 227.33 0)
		(effects
